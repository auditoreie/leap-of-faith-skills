  "limited_time_offer": {
    "name": "lto_blackweek",
    "category": "MARKETING",
    "language": "pt_BR",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "HEADER",
        "format": "IMAGE",
        "example": { "header_handle": ["__HANDLE__"] }
      },
      {
        "type": "BODY",
        "text": "Olá {{1}}, sua oferta exclusiva: {{2}} de desconto em qualquer item da loja.",
        "example": { "body_text": [["Felipe", "20%"]] }
      },
      {
        "type": "LIMITED_TIME_OFFER",
        "limited_time_offer": {
          "text": "Oferta termina em",
          "has_expiration": true
        }
      },
      {
        "type": "BUTTONS",
        "buttons": [
          { "type": "COPY_CODE", "example": "BLACK20" },
          { "type": "URL", "text": "Comprar agora", "url": "https://fgb.com.br/blackweek?ref={{1}}", "example": ["wa"] }
        ]
      }
    ]
  },
  "flow_button_static": {
    "name": "agendamento_via_flow",
    "category": "UTILITY",
    "language": "pt_BR",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "BODY",
        "text": "Olá {{1}}, vamos agendar sua consulta?",
        "example": { "body_text": [["Felipe"]] }
      },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "FLOW",
            "text": "Agendar consulta",
            "flow_id": "__SUBSTITUIR_PELO_FLOW_ID__",
            "navigate_screen": "WELCOME",
            "flow_action": "navigate"
          }
        ]
      }
    ]
  },
