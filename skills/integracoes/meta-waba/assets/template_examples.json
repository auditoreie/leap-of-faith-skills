{
  "_meta": {
    "description": "Payloads canônicos para POST /<WABA_ID>/message_templates. Use como ponto de partida no editor visual ou em testes. Cada chave é um caso típico.",
    "graph_api_version": "v23.0",
    "endpoint": "POST https://graph.facebook.com/v23.0/<WABA_ID>/message_templates",
    "auth_header": "Bearer <BISU_OR_SYSTEM_USER_TOKEN>",
    "validation_checklist": [
      "name em [a-z0-9_]{1,512}",
      "language em xx_XX (pt_BR, en_US, es_MX, etc.)",
      "BODY <= 1024 chars",
      "HEADER text <= 60 chars",
      "FOOTER <= 60 chars",
      "variáveis sequenciais sem pular números",
      "toda variável tem example",
      "AUTHENTICATION sem URL/mídia/emoji",
      "header_handle obtido via Resumable Upload"
    ]
  },
  "utility_text_named_params": {
    "name": "agendamento_confirmacao",
    "category": "UTILITY",
    "language": "pt_BR",
    "parameter_format": "NAMED",
    "components": [
      { "type": "HEADER", "format": "TEXT", "text": "Agendamento confirmado" },
      {
        "type": "BODY",
        "text": "Olá {{nome}}, sua consulta com {{profissional}} está confirmada para {{data}} às {{hora}}.",
        "example": {
          "body_text_named_params": [
            { "param_name": "nome", "example": "Felipe" },
            { "param_name": "profissional", "example": "Dra. Ana Souza" },
            { "param_name": "data", "example": "07/05/2026" },
            { "param_name": "hora", "example": "14:30" }
          ]
        }
      },
      { "type": "FOOTER", "text": "Sintetiza Health" },
      {
        "type": "BUTTONS",
        "buttons": [
          { "type": "QUICK_REPLY", "text": "Confirmar" },
          { "type": "QUICK_REPLY", "text": "Reagendar" },
          { "type": "PHONE_NUMBER", "text": "Ligar para clínica", "phone_number": "+551130000000" }
        ]
      }
    ]
  },
  "utility_text_positional_params": {
    "name": "pedido_entregue",
    "category": "UTILITY",
    "language": "pt_BR",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "BODY",
        "text": "Olá {{1}}, seu pedido #{{2}} foi entregue em {{3}}. Total: R$ {{4}}.",
        "example": {
          "body_text": [["Felipe", "12345", "05/05/2026 14:32", "289,90"]]
        }
      },
      {
        "type": "BUTTONS",
        "buttons": [
          { "type": "URL", "text": "Ver pedido", "url": "https://fgb.com.br/pedidos/{{1}}", "example": ["12345"] }
        ]
      }
    ]
  },
  "marketing_video_header_with_cta": {
    "name": "demo_produto_video",
    "category": "MARKETING",
    "language": "pt_BR",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "HEADER",
        "format": "VIDEO",
        "example": {
          "header_handle": ["__SUBSTITUIR_PELO_HANDLE_DO_RESUMABLE_UPLOAD__"]
        }
      },
      {
        "type": "BODY",
        "text": "Olá {{1}}! Confira nosso novo produto. Use o cupom {{2}} para 10% de desconto.",
        "example": { "body_text": [["Felipe", "MAIO10"]] }
      },
      { "type": "FOOTER", "text": "Oferta válida até 31/05/2026" },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "URL",
            "text": "Comprar agora",
            "url": "https://fgb.com.br/produto?ref={{1}}",
            "example": ["whatsapp"]
          },
          { "type": "COPY_CODE", "example": "MAIO10" }
        ]
      }
    ]
  },
  "marketing_image_header": {
    "name": "campanha_maio_imagem",
    "category": "MARKETING",
    "language": "pt_BR",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "HEADER",
        "format": "IMAGE",
        "example": {
          "header_handle": ["__SUBSTITUIR_PELO_HANDLE__"]
        }
      },
      {
        "type": "BODY",
        "text": "{{1}}, garanta sua vaga no nosso evento de Maio. Vagas limitadas!",
        "example": { "body_text": [["Felipe"]] }
      },
      {
        "type": "BUTTONS",
        "buttons": [
          { "type": "QUICK_REPLY", "text": "Quero garantir" },
          { "type": "QUICK_REPLY", "text": "Mais informações" }
        ]
      }
    ]
  },
  "authentication_otp_copy_code": {
    "name": "otp_login",
    "category": "AUTHENTICATION",
    "language": "pt_BR",
    "components": [
      {
        "type": "BODY",
        "add_security_recommendation": true
      },
      {
        "type": "FOOTER",
        "code_expiration_minutes": 10
      },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "OTP",
            "otp_type": "COPY_CODE",
            "text": "Copiar código"
          }
        ]
      }
    ]
  },
  "authentication_otp_one_tap": {
    "name": "otp_login_onetap",
    "category": "AUTHENTICATION",
    "language": "pt_BR",
    "components": [
      { "type": "BODY", "add_security_recommendation": true },
      { "type": "FOOTER", "code_expiration_minutes": 10 },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "OTP",
            "otp_type": "ONE_TAP",
            "text": "Autopreencher código",
            "autofill_text": "Autopreencher",
            "package_name": "com.fgb.app",
            "signature_hash": "K8a9wuT9yQc"
          }
        ]
      }
    ]
  },
